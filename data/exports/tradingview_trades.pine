//@version=6
indicator("Fidelity Trades Plotter", overlay=true, max_labels_count=500, max_lines_count=500)

// Inputs
show_labels = input.bool(true, "Show Execution Labels")
show_lines  = input.bool(true, "Show Trade Paths (FIFO)")
only_today  = input.bool(false, "Show Today's Trades Only")

// Helper to draw execution labels
draw_execution(time_ms, price, is_buy, tooltip_val, only_today_flag, today_start_ms) =>
    if show_labels and (not only_today_flag or time_ms >= today_start_ms)
        color_val = is_buy ? color.rgb(0, 200, 83) : color.rgb(139, 0, 0)
        style_val = is_buy ? label.style_label_right : label.style_label_left
        text_val  = is_buy ? "▶" : "◀"
        label.new(x=time_ms, y=price, text=text_val, xloc=xloc.bar_time, color=color_val, textcolor=color.white, style=style_val, size=size.small, tooltip=tooltip_val)

// Helper to draw trade path lines
draw_trade_line(t1, p1, t2, p2, pnl, only_today_flag, today_start_ms) =>
    if show_lines and (not only_today_flag or t2 >= today_start_ms)
        line_color = pnl >= 0 ? color.rgb(38, 166, 154, 50) : color.rgb(229, 115, 115, 50)
        line.new(x1=t1, y1=p1, x2=t2, y2=p2, xloc=xloc.bar_time, color=line_color, style=line.style_dashed, width=2)

